# Copia questo file in ".env" e compila i valori.
# Le variabili EXPO_PUBLIC_* sono incluse nel bundle client: non mettere qui segreti,
# solo l'URL pubblico del progetto Supabase e la sua anon key (pensata per il client).
EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Questa invece va impostata come secret lato Supabase (mai nel client):
#   supabase secrets set ANTHROPIC_API_KEY=sk-ant-...
# La lasciamo qui solo a scopo di documentazione locale.
# ANTHROPIC_API_KEY=sk-ant-...
